# Copy to .env (do not commit .env). Docker Compose substitutes ${VAR} from this file or your shell.
DB_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
# Redis AUTH (--requirepass). Compose default dev-insecure-redis if unset; set a strong value in production.
REDIS_PASSWORD=CHANGE_ME
# Required (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Optional: bearer token for tools/loadgen IOC posts (obtain via login or mint with same JWT_SECRET).
# API_BEARER_TOKEN=
