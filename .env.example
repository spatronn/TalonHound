# Copy to .env (do not commit .env). Docker Compose substitutes ${VAR} from this file or your shell.
DB_PASSWORD=CHANGE_ME
# Redis AUTH (--requirepass). Required — compose fails if unset (${REDIS_PASSWORD:?...}).
# Replace CHANGE_ME with a strong unique value (e.g. openssl rand -hex 32). Do not reuse any repo example.
REDIS_PASSWORD=CHANGE_ME
# Required (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Opaque secret for machine IOC posts (header X-Api-Ingest-Token). Not a JWT. openssl rand -hex 32
# API_INGEST_TOKEN=
# Emergency only: allow Authorization: Bearer <JWT> for APIs (weak). Default off.
# ALLOW_JWT_BEARER=

# Dev-only env bootstrap login removed. Clean installs create admin@talonhound.local
# with a unique one-time password (INITIAL_ADMIN_PASSWORD or generated file under
# /data/backups/bootstrap-admin-password.once). must_change_password=true. See docs/deployment.md.
# INITIAL_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/data/backups/bootstrap-admin-password.once

# VirusTotal IOC enrichment
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_ENRICHMENT_TTL_HOURS=24
# VIRUSTOTAL_TIMEOUT_MS=12000

# URLhaus abuse.ch recent CSV export (Auth-Key required). Prefer integration UI credentials; env is fallback.
# URLHAUS_AUTH_KEY=<URLHAUS_AUTH_KEY>

# MalwareBazaar abuse.ch recent CSV export (Auth-Key required). Prefer integration UI credentials; env is fallback.
# MALWAREBAZAAR_AUTH_KEY=<MALWAREBAZAAR_AUTH_KEY>

# ThreatFox abuse.ch recent IOC API (Auth-Key required). Prefer integration UI credentials; env is fallback.
# THREATFOX_AUTH_KEY=<THREATFOX_AUTH_KEY>
# THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
# THREATFOX_RECENT_DAYS=3

# Integration job queue hardening (integration-worker + backend manual trigger)
# INTEGRATION_JOB_TIMEOUT_MS=600000
# EMERGINGTHREATS_JOB_TIMEOUT_MS=2700000
# INTEGRATION_JOB_HEARTBEAT_INTERVAL_MS=30000
# INTEGRATION_JOB_STALE_AFTER_MS=900000
# INTEGRATION_WORKER_SHUTDOWN_GRACE_MS=30000
# INTEGRATION_QUEUE_CLEANUP_INTERVAL_MS=60000
# INTEGRATION_SOURCE_BUSY_DEFER_MS=30000

# T.C. Siber Güvenlik Başkanlığı / USOM official public API (no API key)
# USOM_API_BASE_URL=https://siberguvenlik.gov.tr/api
# USOM_API_PER_PAGE=5000
# USOM_API_TIMEOUT_MS=30000
# USOM_API_MAX_RETRIES=5
# USOM_API_REQUEST_DELAY_MS=250
# USOM_IMPORT_MODE=incremental
# USOM_INCREMENTAL_ENABLED=true
# USOM_INCREMENTAL_OVERLAP_HOURS=24
# USOM_INCREMENTAL_MAX_RECORDS=100000
# USOM_FULL_RECONCILIATION_ENABLED=true
# USOM_FULL_RECONCILIATION_CRON=0 3 * * 0
# USOM_FULL_RECONCILIATION_TIMEZONE=Europe/Istanbul
# USOM_FULL_RECONCILIATION_MAX_AGE_DAYS=8
# USOM_LOOKUP_CACHE_TTL_HOURS=24
# USOM_JOB_TIMEOUT_MS=7200000
# USOM_DB_STATEMENT_TIMEOUT_MS=1800000
# USOM_DB_IDLE_IN_TX_TIMEOUT_MS=600000

# IPinfo Lite on-demand IP enrichment (ASN / country / continent)
# IPINFO_LITE_TOKEN=
# IPINFO_LITE_BASE_URL=https://api.ipinfo.io/lite
# IPINFO_LITE_MAX_CONCURRENCY=3

# DNSMania passive DNS enrichment (manual on-demand from IOC Details > Intelligence)
# DNSMANIA_BASE_URL=http://192.168.1.191:3000
# DNSMANIA_TIMEOUT_MS=10000
# DNSMANIA_ENABLED=true

# ---------------------------------------------------------------------------
# IOC Advanced Search (DSL) + asynchronous search exports
# ---------------------------------------------------------------------------
# Search DSL guards (parser limits)
# IOC_SEARCH_MAX_QUERY_LENGTH=4000
# IOC_SEARCH_MAX_CONDITIONS=30
# IOC_SEARCH_MAX_PARENTHESES_DEPTH=8
# IOC_SEARCH_MAX_IN_ITEMS=100
# Search execution
# IOC_SEARCH_PREVIEW_LIMIT=2000
# IOC_SEARCH_QUERY_TIMEOUT_MS=5000
# Expensive-query classifier (routes broad/non-index-friendly queries to Deep Search)
# IOC_SEARCH_TRIGRAM_MIN_LENGTH=3
# IOC_SEARCH_MAX_INTERACTIVE_OR_BRANCHES=4
# Timezone used to interpret bare date literals (deterministic; default UTC)
# IOC_SEARCH_TIMEZONE=UTC
# Async Deep Search worker (queue: ioc-deep-search)
# IOC_DEEP_SEARCH_QUEUE_NAME=ioc-deep-search
# Background materialization time budget — the ONLY bound on a Deep Search (no row cap).
# IOC_DEEP_SEARCH_QUERY_TIMEOUT_MS=600000
# IOC_DEEP_SEARCH_CANCEL_POLL_MS=1000
# IOC_DEEP_SEARCH_RETENTION_HOURS=24
# IOC_DEEP_SEARCH_METADATA_RETENTION_DAYS=7
# IOC_DEEP_SEARCH_MAX_CONCURRENT_PER_USER=3
# IOC_DEEP_SEARCH_WORKER_CONCURRENCY=2
# IOC_DEEP_SEARCH_CLEANUP_INTERVAL_MS=300000
# Async export worker (queue: ioc-search-export)
# IOC_EXPORT_QUEUE_NAME=ioc-search-export
# IOC_EXPORT_STORAGE_DIR=/data/ioc-search-exports
# IOC_EXPORT_BATCH_SIZE=5000
# IOC_EXPORT_RETENTION_HOURS=24
# IOC_EXPORT_MAX_CONCURRENT_PER_USER=2
# IOC_EXPORT_SOFT_LIMIT=100000
# IOC_EXPORT_HARD_LIMIT=2000000
# IOC_EXPORT_MAX_RETRIES=3
# IOC_EXPORT_WORKER_CONCURRENCY=2
# IOC_EXPORT_CLEANUP_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# System Backup & Restore
# ---------------------------------------------------------------------------
# BACKUP_ENABLED=true
# Default: every Sunday at 00:00 UTC (= 03:00 Europe/Istanbul during EEST; weekly RPO up to ~7 days).
# BACKUP_CRON=0 0 * * 0
# Optional override; falls back to INTEGRATION_SCHEDULE_TIMEZONE (default UTC).
# BACKUP_CRON_TIMEZONE=
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=/data/backups
# BACKUP_ENCRYPTION_ENABLED=false
# BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key
# BACKUP_MAX_CONCURRENT=1
# BACKUP_QUEUE_NAME=system-backup
# BACKUP_STALE_JOB_TIMEOUT_MINUTES=60
# BACKUP_ORPHAN_QUEUED_MINUTES=5
# BACKUP_STALE_RUNNING_MINUTES=60
# BACKUP_PG_DUMP_TIMEOUT_MS=7200000

# --- Published Feed API keys -------------------------------------------------
# Server-side encryption key that makes Published Feed API keys revealable
# (AES-256-GCM). Provide 64 hex chars (= 32 bytes) or a base64/raw 32-byte value.
# Generate one with:  openssl rand -hex 32
# Without it, existing keys keep working but new revealable keys cannot be created.
# API_KEY_ENCRYPTION_KEY=
# Per-key pull rate limit for /api/published-feeds/{slug} (requests/min, default 60).
# FEED_PUBLIC_RATE_LIMIT_PER_MIN=60
